# ============================================================
# kurigram-mcp 配置示例(开发模式)
#
# 用户配置方式:运行 `kurigram-mcp setup` 交互式生成
# ~/.kurigram-mcp/config.yaml(唯一配置入口,无需设置环境变量)。
#
# 本文件仅供从源码开发时兜底,加载顺序(高 → 低):
#   环境变量 > ~/.kurigram-mcp/config.yaml > 本文件
# ============================================================

# Telegram API 凭据(必填,来自 https://my.telegram.org/apps)
API_ID=
API_HASH=

# 会话文件默认命名:u_{API_ID}.session(与 API_ID 绑定);
# 仅在未配置 API_ID 时退回 SESSION_NAME 命名
SESSION_NAME=kurigram
# 会话/数据目录。默认固定 ~/.kurigram-mcp(与运行目录无关);
# 如需自定义(如开发时留在项目目录),显式设置 SESSION_DIR=.
SESSION_DIR=

# 聊天白名单(fail-closed):逗号分隔
#   - 数字 chat_id(群/频道用负 ID,如 -1001234567890)
#   - @username(启动时自动解析为 chat_id;解析失败默认跳过并警告)
#   - me(自己的 Saved Messages)
# 示例:ALLOWED_CHAT_IDS=-1001234567890,@mybot,me
# 注:HTTP 模式下客户端可用请求头 X-Kurigram-Allowed-Chats 覆盖(per-client)
ALLOWED_CHAT_IDS=
# STRICT 模式:白名单条目解析失败时直接启动失败(默认 false,跳过并警告)
STRICT_WHITELIST=false

# MCP 服务器监听(默认只绑本机回环)
HOST=127.0.0.1
PORT=8765
# Bearer 鉴权(推荐开启):客户端需带 Authorization: Bearer <token>
# setup 会自动生成;此处用于开发模式显式指定
AUTH_TOKEN=

# 可选代理(访问 Telegram 需要时;支持 socks5/http)
# 格式:socks5://user:pass@host:port 或 http://host:port
PROXY=

# 日志级别:TRACE / DEBUG / INFO / SUCCESS / WARNING / ERROR
LOG_LEVEL=INFO
